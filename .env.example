# ==========================================
# Multi-Tenant RAG Customer Support SaaS Config
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL + pgvector)
# If DATABASE_URL is set, it will connect to PostgreSQL via node-postgres (pg).
# If DATABASE_URL is empty, it will automatically use the embedded PostgreSQL 16 + pgvector engine (PGlite) with data persistence in server/data/pglite_db.
DATABASE_URL=

# Firebase Admin SDK Credentials
# Required for production token verification and Firebase Storage
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# AI / LLM Configuration
# Options: 'gemini', 'openai', 'mock'
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Vector Embedding Configuration
# Options: 'gemini', 'openai', 'mock'
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004

# Storage Provider
# Options: 'local', 'firebase'
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
